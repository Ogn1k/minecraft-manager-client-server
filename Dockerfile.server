FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet restore src/MinecraftManager.Server.Api/MinecraftManager.Server.Api.csproj
RUN dotnet publish src/MinecraftManager.Server.Api/MinecraftManager.Server.Api.csproj -c Release --no-restore -o /app

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
RUN adduser --disabled-password --gecos "" --home /nonexistent appuser
COPY --from=build /app .
USER appuser
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
ENTRYPOINT ["dotnet", "MinecraftManager.Server.Api.dll"]
