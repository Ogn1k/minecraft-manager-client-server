<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:MinecraftManager.App.Views"
        x:Class="MinecraftManager.App.Views.MainWindow"
        Title="{Binding WindowTitle}" Width="1100" Height="760" MinWidth="900" MinHeight="600">
  <Grid>
    <Panel IsVisible="{Binding Simple.IsSimpleMode}">
      <Image Source="{Binding BackgroundPortrait}"
             IsVisible="{Binding BackgroundPortrait, Converter={x:Static ObjectConverters.IsNotNull}}"
             HorizontalAlignment="Left"
             VerticalAlignment="Bottom"
             StretchDirection="DownOnly"
             Opacity="0.35"
             Width="512"
             Height="512"
             Margin="24,0,0,24"
             IsHitTestVisible="False" />
      <views:SimpleLauncherView DataContext="{Binding Simple}" />
    </Panel>
    <Grid RowDefinitions="Auto,*" IsVisible="{Binding Simple.IsAdvancedMode}">
    <Border Padding="20,14" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto,Auto"><TextBlock Text="{Binding WindowTitle}" FontSize="20" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding LocalModeText}" Classes="muted" /><Button Grid.Column="2" Margin="16,0,0,0" Content="{Binding Simple.AdvancedText}" Command="{Binding Simple.ToggleAdvancedCommand}" /></Grid>
    </Border>
    <Panel Grid.Row="1">
      <Image Source="{Binding BackgroundPortrait}" IsVisible="{Binding BackgroundPortrait, Converter={x:Static ObjectConverters.IsNotNull}}" HorizontalAlignment="Left" VerticalAlignment="Bottom" StretchDirection="DownOnly" Opacity="0.35" Width="512" Height="512" Margin="24,0,0,24" IsHitTestVisible="False" />
      <TabControl SelectedIndex="{Binding SelectedNavigationIndex}">
      <TabItem Header="Instances">
        <Grid ColumnDefinitions="260,*">
          <Border Padding="16" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto">
              <TextBlock Text="{Binding InstancesText}" Classes="heading" />
              <ListBox Grid.Row="1" Margin="0,12" ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}">
                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" Padding="8" /></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <Button Grid.Row="2" Content="{Binding DeleteInstanceText}" Click="DeleteInstance_Click" IsEnabled="{Binding HasInstances}" />
            </Grid>
          </Border>
          <ScrollViewer Grid.Column="1"><StackPanel Margin="28" Spacing="12" MaxWidth="760">
            <TextBlock Text="{Binding AddInstanceText}" Classes="heading" />
            <TextBlock Text="{Binding NameText}" /><TextBox Text="{Binding NewInstanceName}" />
            <TextBlock Text="{Binding MinecraftFolderText}" />
            <Grid ColumnDefinitions="*,Auto,Auto"><TextBox Text="{Binding MinecraftRoot}" /><Button Grid.Column="1" Margin="8,0,0,0" Content="{Binding DefaultText}" Click="DefaultMinecraft_Click" /><Button Grid.Column="2" Margin="8,0,0,0" Content="{Binding BrowseText}" Click="BrowseMinecraft_Click" /></Grid>
            <TextBlock Text="{Binding UpdateSourceText}" /><ComboBox ItemsSource="{Binding SourceTypes}" SelectedItem="{Binding SelectedSourceType}" />
            <TextBlock Text="{Binding LocalPackFolderText}" />
            <Grid ColumnDefinitions="*,Auto"><TextBox Text="{Binding LocalSourceRoot}" /><Button Grid.Column="1" Margin="8,0,0,0" Content="{Binding BrowseText}" Click="BrowseSource_Click" /></Grid>
            <TextBlock Text="{Binding StaticHttpUrlText}" /><TextBox Text="{Binding RemoteHttpUrl}" />
            <CheckBox Content="{Binding AllowHttpText}" IsChecked="{Binding AllowInsecureLanHttp}" />
            <TextBlock Text="{Binding ManagedProfileText}" /><ComboBox ItemsSource="{Binding ServerProfiles}" SelectedItem="{Binding SelectedServerProfile}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
            <TextBlock Text="{Binding ManagedPackIdText}" /><TextBox Text="{Binding AssignedPackId}" />
            <Button Content="{Binding SaveInstanceText}" Command="{Binding AddInstanceCommand}" Classes="primary" />
          </StackPanel></ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem Header="Updates">
        <ScrollViewer><StackPanel Margin="28" Spacing="16" MaxWidth="800">
          <TextBlock Text="Updates" Classes="heading" /><TextBlock Text="{Binding SelectedSummary}" TextWrapping="Wrap" />
          <Border IsVisible="{Binding HasRecovery}" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="2" Padding="14" CornerRadius="6">
            <StackPanel Spacing="8"><TextBlock Text="{Binding InterruptedUpdateText}" FontWeight="SemiBold" /><TextBlock Text="{Binding RollbackAdviceText}" TextWrapping="Wrap" /><Button Content="{Binding RollbackText}" Command="{Binding RecoverCommand}" HorizontalAlignment="Left" /></StackPanel>
          </Border>
          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" /><Button Grid.Column="1" Content="{Binding CheckUpdatesText}" Command="{Binding CheckForUpdatesCommand}" /></Grid>
          <Border IsVisible="{Binding HasError}" BorderBrush="{DynamicResource ThemeBorderMidBrush}" BorderThickness="2" Padding="14" CornerRadius="6">
            <StackPanel Spacing="8"><TextBlock Text="{Binding ErrorMessage}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding TechnicalDetails}" Classes="muted" TextWrapping="Wrap" /><Button Content="{Binding DismissText}" Command="{Binding DismissErrorCommand}" HorizontalAlignment="Left" /></StackPanel>
          </Border>
          <Border IsVisible="{Binding HasPlan}" Padding="18" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="2" CornerRadius="8">
            <StackPanel Spacing="12"><TextBlock Text="{Binding ReviewUpdateText}" Classes="heading" /><TextBlock Text="{Binding ExactChangesText}" TextWrapping="Wrap" /><ListBox ItemsSource="{Binding PlannedChanges}" MaxHeight="300" /><TextBlock Text="{Binding CloseMinecraftText}" Classes="muted" TextWrapping="Wrap" /><Button Content="{Binding InstallUpdateText}" Command="{Binding InstallUpdateCommand}" Classes="primary" /></StackPanel>
          </Border>
          <StackPanel IsVisible="{Binding IsBusy}" Spacing="8"><ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercentage}" /><TextBlock Text="{Binding ProgressMessage}" Classes="muted" /><Button IsVisible="{Binding CancellationAvailable}" Content="{Binding CancelText}" Command="{Binding CancelOperationCommand}" HorizontalAlignment="Left" /></StackPanel>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="Launcher"><views:LauncherView DataContext="{Binding Launcher}" /></TabItem>
      <TabItem Header="Servers">
        <ScrollViewer><StackPanel Margin="28" Spacing="12" MaxWidth="700">
          <TextBlock Text="Servers" Classes="heading" /><TextBlock Text="{Binding CredentialsInfoText}" Classes="muted" TextWrapping="Wrap" />
          <TextBlock Text="{Binding DisplayNameText}" /><TextBox Text="{Binding ServerDisplayName}" />
          <TextBlock Text="{Binding HttpsAddressText}" /><TextBox Text="{Binding ServerUrl}" />
          <TextBlock Text="{Binding RegistrationCodeText}" /><TextBox Text="{Binding RegistrationCode}" PasswordChar="●" />
          <Button Content="{Binding SaveRegisterText}" Command="{Binding SaveServerProfileCommand}" Classes="primary" />
          <ItemsControl ItemsSource="{Binding ServerProfiles}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" Margin="0,4" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="History">
        <ScrollViewer><StackPanel Margin="28" Spacing="12"><TextBlock Text="{Binding RecentHistoryText}" Classes="heading" /><TextBlock Text="{Binding SelectedSummary}" /><ItemsControl ItemsSource="{Binding History}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="120,*,Auto" Margin="0,5"><TextBlock Text="{Binding PackVersion}" /><TextBlock Grid.Column="1" Text="{Binding Source}" /><TextBlock Grid.Column="2" Text="{Binding Succeeded}" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="Settings">
        <StackPanel Margin="28" Spacing="10" MaxWidth="600"><TextBlock Text="{Binding SettingsText}" Classes="heading" /><TextBlock Text="{Binding ThemeText}" /><ComboBox ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding SelectedTheme}" /><TextBlock Text="{Binding LanguageText}" /><ComboBox ItemsSource="{Binding LanguageChoices}" SelectedItem="{Binding SelectedLanguage}" /><TextBlock Text="{Binding MaxDownloadsText}" /><NumericUpDown Minimum="1" Maximum="8" Value="{Binding MaximumConcurrentDownloads}" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="{Binding SaveSettingsText}" Command="{Binding SaveSettingsCommand}" /><Button Content="{Binding ExportDiagnosticsText}" Command="{Binding ExportDiagnosticsCommand}" /></StackPanel></StackPanel>
      </TabItem>
    </TabControl>
    </Panel>
    </Grid>
  </Grid>
</Window>
